# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) during development.

# Server-only secret key — NEVER expose this to the browser
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Public key — safe to expose in browser (used by @stripe/stripe-js if needed)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used to build success/cancel redirect URLs in the API route.
# In production set this to your actual domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
