# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) during development.

# Server-only secret key — NEVER expose this to the browser
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Public key — safe to expose in browser (used by @stripe/stripe-js if needed)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used to build success/cancel redirect URLs in the API route.
# In production set this to your actual domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service-role key. Never prefix this with NEXT_PUBLIC_ and never
# use it in a client component. Required by lib/supabase-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional transactional email. Without this, the development console adapter is used.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL="GLASSSKIN <orders@example.com>"

# ─── Tax (GST) ─────────────────────────────────────────────────────────────────
# GST rate applied to tax-inclusive MRP, e.g. 18 for 18%. The order total shown to
# customers already includes this tax; only the tax component is recorded per order.
GST_RATE=18

# ─── Cash on Delivery ───────────────────────────────────────────────────────────
# COD is enabled when this is "true". Customers pay the courier at delivery.
NEXT_PUBLIC_COD_ENABLED=true
